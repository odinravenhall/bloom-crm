{
  "name": "bloom-desktop",
  "productName": "Bloom",
  "version": "0.1.0",
  "description": "Bloom CRM en application Windows : le CRM + le vrai site OnlyFans de chaque modèle, une session par modèle.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "fr.bloomcrm.desktop",
    "productName": "Bloom",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js"],
    "win": { "target": "nsis", "signAndEditExecutable": false },
    "nsis": { "oneClick": true, "perMachine": false, "shortcutName": "Bloom" }
  }
}
