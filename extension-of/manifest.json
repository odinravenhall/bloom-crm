{
  "manifest_version": 3,
  "name": "Bloom – Relier OnlyFans",
  "version": "1.1",
  "description": "Relie un compte OnlyFans à Bloom CRM : Bloom ouvre onlyfans.com, tu te connectes normalement, l'extension envoie la session à Bloom. Le mot de passe n'est jamais lu.",
  "permissions": ["cookies", "scripting", "tabs", "storage"],
  "host_permissions": ["https://onlyfans.com/*", "https://bloom.ravencrm.xyz/*", "https://bloomcrm.fr/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://bloom.ravencrm.xyz/*", "https://bloomcrm.fr/*"], "js": ["bloom.js"], "run_at": "document_start" }],
  "action": { "default_title": "Bloom – Relier OnlyFans", "default_popup": "popup.html" }
}
